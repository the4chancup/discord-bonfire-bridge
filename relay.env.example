# discord-relay (Discord -> Bonfire relay). Loaded via env_file in
# docker-compose.yml; DISCORD_TOKEN is injected separately from .env.
#
# IMPORTANT: this file MUST end with a trailing newline. Docker Compose's
# env_file parser can glue an appended line onto the previous value if the
# last line has no newline (it once broke BONFIRE_BOT_TOKEN itself).
BONFIRE_BOT_TOKEN=

# Optional (defaults shown):
# BONFIRE_URL=https://bonfire.implyingrigged.info
# RELAY_GUILD_IDS=124029625755107328,288816233015410698,365557463430463488
# RELAY_CHANNEL_ALLOWLIST=
# RELAY_DRY_RUN=
# ACCOUNTS_FILE=/data/accounts.json
# STATE_DB=/data/relay.db
# RELAY_BACKFILL_SINCE=2026-09-27T00:00:00Z
# RELAY_MAX_FILE_BYTES=26214400
